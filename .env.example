# ============ LLM Configuration ============
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_MODEL=gemini-3.5-flash

# ============ Database ============
DATABASE_URL=postgresql://analyst:analyst_password@localhost:5432/data_analyst
REDIS_URL=redis://localhost:6379/0

# ============ Storage (MinIO) ============
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=datasets
MINIO_SECURE=false

# ============ Security ============
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ App Config ============
MAX_UPLOAD_SIZE_MB=500
MAX_ANALYSIS_TIMEOUT_SECONDS=600
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_CPU_LIMIT=2

# ============ CORS (comma-separated production origins) ============
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============ Observability (Optional) ============
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============ Frontend ============
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
